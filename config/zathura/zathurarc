set default-fg                "#d9d9d9"
set default-bg                "#171717"

set completion-bg             "#292929"
set completion-fg             "#d9d9d9"
set completion-highlight-bg   "#76bef9"
set completion-highlight-fg   "#171717"
set completion-group-bg       "#0d0d0d"
set completion-group-fg       "#d9d9d9"

set statusbar-fg              "#d9d9d9"
set statusbar-bg              "#0d0d0d"
set inputbar-fg               "#d9d9d9"
