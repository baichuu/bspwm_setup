#!/usr/bin/env bash

audio_status="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)"
volume_value="${audio_status#*: }"
volume_value="${volume_value%% *}"
printf -v volume '%.0f' "${volume_value:-0}e2" 2>/dev/null || volume=0
[[ "$volume" =~ ^[0-9]+$ ]] || volume=0

if [[ $audio_status == *MUTED* ]]; then
  muted=true
else
  muted=false
fi

printf '{"volume":%d,"muted":%s}\n' "$volume" "$muted"
