configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
    icon-theme: "Papirus-Dark";
}

* {
    background: #171717;
    background-alt: #171717E0;
    foreground: #d9d9d9;
    selection-background: #292929;
    urgent: #ff7575;
    border-colour: #242424;
    font: "Iosevka Nerd Font 18";
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 620px;
    margin: 0px;
    padding: 0px;
    border: 0px;
    border-radius: 35px;
    background-color: @background;
}

mainbox {
    spacing: 12px;
    padding: 14px;
    border: 2px;
    border-color: @border-colour;
    border-radius: 35px;
    background-color: transparent;
    children: [ inputbar, message, listview ];
}

inputbar {
    spacing: 10px;
    padding: 8px 12px;
    border: 1px;
    border-color: @border-colour;
    border-radius: 200px;
    background-color: @selection-background;
    text-color: @foreground;
    children: [ textbox-prompt-colon, entry, textbox-title-close ];
}

textbox-prompt-colon {
    enabled: true;
    expand: false;
    padding: 3px 6px 3px 5px;
    str: " ";
    background-color: inherit;
    text-color: inherit;
}

entry {
    enabled: true;
    padding: 3px 0px;
    background-color: inherit;
    text-color: inherit;
    cursor: text;
    placeholder: "Search applications";
    placeholder-color: inherit;
}

textbox-title-close {
    enabled: true;
    expand: false;
    padding: 3px;
    str: " ";
    background-color: transparent;
    text-color: @urgent;
}

listview {
    enabled: true;
    columns: 1;
    lines: 8;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    spacing: 4px;
    margin: 0px;
    border: 0px;
    background-color: transparent;
    text-color: @foreground;
    cursor: default;
}

element {
    enabled: true;
    orientation: horizontal;
    children: [ element-icon, element-text ];
    spacing: 12px;
    padding: 8px 10px;
    border: 0px;
    border-radius: 200px;
    background-color: transparent;
    text-color: @foreground;
    cursor: pointer;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @selection-background;
    text-color: @foreground;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 36px;
    horizontal-align: 0.5;
    cursor: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

message {
    margin: 0px;
    padding: 0px;
    border: 0px;
    background-color: transparent;
    text-color: @foreground;
}

textbox {
    padding: 8px 10px;
    border: 0px;
    border-radius: 20px;
    background-color: @background-alt;
    text-color: @foreground;
    vertical-align: 0.5;
    horizontal-align: 0.0;
    markup: true;
}

error-message {
    padding: 10px;
    border: 2px;
    border-radius: 20px;
    border-color: @border-colour;
    background-color: @background;
    text-color: @foreground;
}
