[global]
monitor = 0
follow = mouse
width = (300, 500)
origin = top-center
offset = (0, 24)
notification_limit = 20
indicate_hidden = yes
transparency = 0
gap_size = 8
separator_height = 1
separator_color = "#ff7575"
padding = 15
horizontal_padding = 15
text_icon_padding = 12
frame_width = 3
frame_color = "#242424"
sort = no
font = Iosevka Nerd Font 10
line_height = 0
markup = full
format = "<span size='large' weight='bold' foreground='#76bef9'>%s</span>\n%b"
alignment = left
vertical_alignment = center
ellipsize = middle
ignore_newline = no
stack_duplicates = false
hide_duplicate_count = true
show_indicators = yes
enable_recursive_icon_lookup = true
icon_theme = Papirus-Dark
icon_position = left
min_icon_size = 48
max_icon_size = 64
default_icon = ~/.config/dunst/notification.png
new_icon = ~/.config/dunst/notification.png
sticky_history = yes
history_length = 25
browser = chromium
corner_radius = 12
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all
progress_bar = false

[urgency_low]
timeout = 3
background = "#171717"
foreground = "#62cae9"

[urgency_normal]
timeout = 5
background = "#171717"
foreground = "#e9a144"

[urgency_critical]
timeout = 0
background = "#171717"
foreground = "#ff7575"
